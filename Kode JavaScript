    event.target.value;

  document
    .querySelectorAll("[data-i18n]")
    .forEach(element => {

      element.innerHTML =
        texts[language][
          element.dataset.i18n
        ];

    });

};


/* =========================
   PESAN WHATSAPP
========================= */

$("#orderBtn").onclick = () => {

  if (cart.length === 0) {

    alert(
      "Keranjang masih kosong."
    );

    return;
  }


  let message =
    "Halo kak aku mau pesan:";


  cart.forEach(item => {

    const product =
      products.find(
        p => p.id === item.id
      );

    message +=
      `\n${item.qty} ${product.name}`;

  });


  const whatsappURL =
    "https://wa.me/?text=" +
    encodeURIComponent(message);


  window.open(
    whatsappURL,
    "_blank"
  );

};


