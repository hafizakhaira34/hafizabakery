let cart = JSON.parse(
  localStorage.getItem("hafizaCart") || "[]"
);

const $ = selector => document.querySelector(selector);

const rupiah = number =>
  new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0
  }).format(number);


/* =========================
   MENAMPILKAN PRODUK
========================= */

function renderProducts(list = products) {

  $("#productGrid").innerHTML = list.map(product => `
    <article class="product">

      <img
        src="${product.img}"
        alt="${product.name}"
        loading="lazy"
      >

      <div class="product-body">

        <h3>${product.name}</h3>

        <p>
          Freshly baked every day.
        </p>

        <div class="price">
          ${rupiah(product.price)}
        </div>

        <button
          class="add"
          onclick="addToCart(${product.id})"
        >
          + Add to cart
        </button>

      </div>

    </article>
  `).join("");

  $("#emptyState").hidden = list.length !== 0;
}


/* =========================
   TAMBAH KE KERANJANG
========================= */

function addToCart(id) {

  const existing = cart.find(
    item => item.id === id
  );

  if (existing) {

    existing.qty++;

  } else {

    cart.push({
      id: id,
      qty: 1
    });

  }

  saveCart();

  openCart();
}


/* =========================
   SIMPAN KERANJANG
========================= */

function saveCart() {

  localStorage.setItem(
    "hafizaCart",
    JSON.stringify(cart)
  );

  renderCart();
}


/* =========================
   MENAMPILKAN KERANJANG
========================= */

function renderCart() {

  const totalItems = cart.reduce(
    (total, item) => total + item.qty,
    0
  );

  $("#cartCount").textContent = totalItems;


  if (cart.length === 0) {

    $("#cartItems").innerHTML = `
      <p class="empty">
        Keranjang masih kosong.
      </p>
    `;

  } else {

    $("#cartItems").innerHTML = cart.map(item => {

      const product = products.find(
        p => p.id === item.id
      );

      return `
        <div class="cart-item">

          <img
            src="${product.img}"
            alt="${product.name}"
          >

          <div>

            <h4>
              ${product.name}
            </h4>

            <p>
              ${rupiah(product.price)}
            </p>

            <div class="qty">

              <button
                onclick="changeQty(${product.id}, -1)"
              >
                −
              </button>

              <b>
                ${item.qty}
              </b>

              <button
                onclick="changeQty(${product.id}, 1)"
              >
                +
              </button>

            </div>

          </div>

        </div>
      `;

    }).join("");

  }


  const totalPrice = cart.reduce(
    (total, item) => {

      const product = products.find(
        p => p.id === item.id
      );

      return total +
        product.price * item.qty;

    },
    0
  );

  $("#cartTotal").textContent =
    rupiah(totalPrice);
}


/* =========================
   UBAH JUMLAH PRODUK
========================= */

function changeQty(id, amount) {

  const item = cart.find(
    product => product.id === id
  );

  if (!item) return;

  item.qty += amount;


  if (item.qty <= 0) {

    cart = cart.filter(
      product => product.id !== id
    );

  }

  saveCart();
}


/* =========================
   BUKA KERANJANG
========================= */

function openCart() {

  $("#cartPanel")
    .classList
    .add("open");

  $("#overlay")
    .classList
    .add("show");
}


/* =========================
   TUTUP KERANJANG
========================= */

function closeCart() {

  $("#cartPanel")
    .classList
    .remove("open");

  $("#overlay")
    .classList
    .remove("show");
}


/* =========================
   BUTTON KERANJANG
========================= */

$("#cartBtn").onclick = openCart;

$("#closeCart").onclick = closeCart;

$("#overlay").onclick = closeCart;


/* =========================
   SEARCH
========================= */

$("#searchBtn").onclick = () => {

  const keyword =
    $("#searchInput")
      .value
      .toLowerCase()
      .trim();

  const results = products.filter(
    product =>
      product.name
        .toLowerCase()
        .includes(keyword)
  );

  renderProducts(results);
};


$("#searchInput").addEventListener(
  "input",
  () => $("#searchBtn").click()
);


